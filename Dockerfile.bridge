FROM node:22.23.1-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build

FROM node:22.23.1-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/codec-assets.lock.json ./
COPY --from=build /app/.artifacts/codecs ./.artifacts/codecs
COPY --from=build /app/.artifacts/build/cyrinx ./.artifacts/build/cyrinx
USER node
EXPOSE 4310
CMD ["node", "dist/server/packages/bridge/src/runner.js"]
