{
  "name": "fips-over-sound",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "verify:dependencies": "node scripts/audit-dependencies.mjs --check-lock package-lock.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:browser": "playwright test --pass-with-no-tests",
    "test:browser:production": "playwright test --config playwright.production.config.ts",
    "test:skeleton": "vitest run tests/skeleton.test.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && vite build",
    "start:runner": "node dist/server/packages/bridge/src/runner.js",
    "qualification:serve": "node dist/server/packages/bridge/src/runner.js",
    "fetch:codecs": "node scripts/fetch-codec-assets.mjs",
    "fetch:codecs:check": "node scripts/fetch-codec-assets.mjs --check",
    "cyrinx:build": "node scripts/build-cyrinx.mjs",
    "cyrinx:test": "npm run cyrinx:build && node --test tests/cyrinx-batch.test.mjs",
    "smoke:self-loop": "npm run build && node scripts/self-loop-smoke.mjs",
    "generate:corpus": "node scripts/generate-corpus.mjs",
    "qualify:fixture": "node scripts/qualify.mjs fixture",
    "qualify:verify": "node scripts/qualify.mjs verify",
    "test:compose": "node --test tests/fips-compose.test.mjs && node scripts/check-compose.mjs && node scripts/check-compose.mjs --fips-source",
    "test:fips-compose:runtime": "node scripts/fips-compose-smoke.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:check": "node scripts/demo.mjs --check",
    "check": "npm run verify:dependencies && npm run lint && npm run typecheck && npm run test:unit && npm run test:browser && npm run build && npm run generate:corpus -- --check && npm run qualify:fixture && npm run qualify:verify && npm run test:compose"
  },
  "dependencies": {
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/ws": "8.18.1",
    "eslint": "10.7.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
